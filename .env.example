# 複製為 .env 後修改；不建 .env 時 docker-compose.yml 會使用下列預設值

# --- MariaDB ---
DB_ROOT_PASSWORD=rootpass
DB_USER=monitor
DB_PASSWORD=monitorpass
DB_NAME=monitor
# 主機對外的 port（本機已有 MySQL/MariaDB 佔用 3306 時可改）
DB_HOST_PORT=3306

# --- 連接池 ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- API ---
API_HOST_PORT=8000
