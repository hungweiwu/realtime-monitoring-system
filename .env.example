# 複製為 .env 後修改；不建 .env 時 docker-compose.yml 會使用下列預設值

# --- MariaDB ---
DB_ROOT_PASSWORD=rootpass
DB_USER=monitor
DB_PASSWORD=monitorpass
DB_NAME=monitor
# 只有 docker-compose.dev.yml 會對主機開這個 port（本機開發用）
DB_HOST_PORT=3306
# 容器內固定為 db:3306；只有不經 Docker 在本機跑 API 時才需要設定
# DB_HOST=localhost
# DB_PORT=3306

# --- 連接池 ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# 連線使用超過此秒數就換新，避免拿到被 MariaDB wait_timeout 切掉的連線
DB_POOL_RECYCLE_SECONDS=1800

# --- API ---
API_HOST_PORT=8000
# --- 前端 ---
FRONTEND_HOST_PORT=8501
# 即時監控頁的瀏覽器端 JS 連線用（不是容器內位址）；API_HOST_PORT 改了這裡也要跟著改
PUBLIC_WS_URL=ws://localhost:8000

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# --- JWT ---
# 正式環境務必改成足夠長的隨機字串，例如：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me-in-production-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- 批量匯入 ---
# 檔案大小上限（bytes，預設 5 MB）與列數上限
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=10000
# 匯入資料的時間沒帶時區時，視為此時區
IMPORT_DEFAULT_TIMEZONE=Asia/Taipei

# --- 即時資料產生器 ---
ENABLE_GENERATOR=true
# 每幾秒產生一筆
METRIC_INTERVAL_SECONDS=1
# 低於 LOW 或高於 HIGH 標記為異常
METRIC_ANOMALY_LOW=10
METRIC_ANOMALY_HIGH=90

# --- 批次寫入 ---
# 每 FLUSH_INTERVAL_SECONDS 秒，或累積 FLUSH_BATCH_SIZE 筆時寫入一次（先到者觸發）
FLUSH_INTERVAL_SECONDS=5
FLUSH_BATCH_SIZE=50
# DB 寫不進去時 buffer 最多保留幾筆，超過丟最舊的
BUFFER_MAX_SIZE=10000
# 單一 WebSocket 連線送一筆資料的逾時秒數，超過視為慢連線並斷開
WS_SEND_TIMEOUT_SECONDS=1

# --- 資料分析 ---
# 趨勢分析切分分／時／日、Excel 匯出時間所用的時區（IANA 名稱）
ANALYTICS_TIMEZONE=Asia/Taipei
# Excel 匯出 data 工作表的列數上限（超過時保留最新的資料）
EXPORT_MAX_ROWS=50000

# --- 種子帳號（啟動時若不存在則建立）---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345
SEED_USER_USERNAME=user
SEED_USER_PASSWORD=user12345
SEED_VIEWER_USERNAME=viewer
SEED_VIEWER_PASSWORD=viewer12345
